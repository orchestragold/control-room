# ─── Flask ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string

# 'development' disables secure-cookie requirement for local testing
FLASK_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL via cPanel:  mysql+pymysql://DB_USER:DB_PASSWORD@localhost/DB_NAME
# Local dev SQLite:  sqlite:///dev.db
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@localhost/DB_NAME

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must be: https://control.orchestragold.com/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── Access Control ───────────────────────────────────────────────────────────
# SUPER_ADMIN_EMAILS: full access to everything; gets super_admin role at first login
# EDITOR_EMAILS: gets editor role at first login; project permissions set separately in DB
# ALLOWED_EMAILS: must include everyone who should be able to log in at all
SUPER_ADMIN_EMAILS=orchestragold@gmail.com
EDITOR_EMAILS=maeve.chiarella11@gmail.com
ALLOWED_EMAILS=orchestragold@gmail.com,maeve.chiarella11@gmail.com

# ─── App Mode ─────────────────────────────────────────────────────────────────
# 'test'  — all outbound sends redirect to TEST_REDIRECT_EMAIL instead of real recipients
# 'live'  — sends to real addresses (flip this deliberately, not by accident)
APP_MODE=test
TEST_REDIRECT_EMAIL=orchestragold@gmail.com

# ─── HubSpot ──────────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=

# ─── Asana ────────────────────────────────────────────────────────────────────
ASANA_ACCESS_TOKEN=

# ─── Google Calendar ──────────────────────────────────────────────────────────
# Calendar ID for the calendar Control Room reads/writes holds on
GOOGLE_CALENDAR_ID=
# Path to the service account JSON file, or the JSON content as a single line
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── MailerLite ───────────────────────────────────────────────────────────────
MAILERLITE_API_KEY=

# ─── Dropbox ──────────────────────────────────────────────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# ─── Zoho Mail OAuth ──────────────────────────────────────────────────────────
# Email provider for pitch sending. Move these from the existing scheduled task's
# prompt into cPanel env vars — do NOT leave them in any Claude prompt or git file.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_FROM_EMAIL=
